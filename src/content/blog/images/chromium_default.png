  function clean(){
    if(!isHome()) return;
    document.querySelectorAll('a.google-anno').forEach(unwrap);
    document.querySelectorAll('.google-anno-skip, .google-anno-sc, .google-anno-sa-qtx, #google-anno-sa, #google-anno-sa-glow, google-anno-sa').forEach(function(el){el.remove();});
