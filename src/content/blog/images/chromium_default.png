.lg2-list a .lg2-d{display:block;font-size:12.5px;color:var(--muted);font-weight:400;margin-top:3px}

/* Featured series */
.lg2-feature{background:var(--soft);border:1px solid var(--line);border-radius:var(--r);padding:32px;display:grid;grid-template-columns:1fr 1fr;gap:34px;align-items:center}
