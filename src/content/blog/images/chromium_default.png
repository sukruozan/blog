.lg2-author .lg2-profile{font-size:13.5px;font-weight:600;color:var(--head)}
.lg2-author .lg2-profile:hover{color:var(--accent)}

/* FAQ */
.lg2-faq details{border:1px solid var(--line);border-radius:var(--r);padding:0;margin-bottom:12px;background:#fff}
.lg2-faq summary{cursor:pointer;padding:16px 20px;font-weight:600;color:var(--head);font-size:16px;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:14px}
.lg2-faq summary::-webkit-details-marker{display:none}
.lg2-faq summary:after{content:"+";font-size:22px;font-weight:400;color:var(--muted);line-height:1}
.lg2-faq details[open] summary:after{content:"\2212"}
.lg2-faq details[open] summary{border-bottom:1px solid var(--line)}
.lg2-faq .lg2-ans{padding:16px 20px;color:#444;font-size:15px}
.lg2-faq .lg2-ans a{color:var(--accent-d);font-weight:600}

/* Trust */
.lg2-trust{background:var(--dark);color:#fff;border-radius:var(--r);padding:36px;display:grid;grid-template-columns:1.2fr 1fr;gap:30px;align-items:center}
